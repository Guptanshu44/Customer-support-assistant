# ============================================================
# OmniDesk Copilot — .gitignore
# ============================================================

# ⚠️  CRITICAL: API Keys & Secrets — NEVER commit these
.env
.env.*
!.env.example
*.env
.envrc
secrets.json
secrets.yaml
secrets.toml
api_keys.txt
api_keys.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
build/
.eggs/
!frontend/dist/


# HuggingFace model cache (large files, downloaded at runtime)
.cache/
models/

# FAISS index cache (auto-rebuilt at startup)
*.index
*.faiss

# SQLite session history database (contains user conversation data)
sessions.db
*.db

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Streamlit
.streamlit/secrets.toml

# Node / React
node_modules/
frontend/node_modules/
.npm

